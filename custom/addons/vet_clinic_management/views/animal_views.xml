<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- vet.animal Tree View -->
        <record id="view_vet_animal_tree" model="ir.ui.view">
            <field name="name">vet.animal.tree</field>
            <field name="model">vet.animal</field>
            <field name="arch" type="xml">
                <tree string="Animals">
                    <field name="name"/>
                    <field name="species"/>
                    <field name="breed"/>
                    <field name="owner_id"/>
                </tree>
            </field>
        </record>

        <!-- vet.animal Form View -->
        <record id="view_vet_animal_form" model="ir.ui.view">
            <field name="name">vet.animal.form</field>
            <field name="model">vet.animal</field>
            <field name="arch" type="xml">
                <form string="Animal">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="species"/>
                            <field name="breed"/>
                            <field name="date_of_birth"/>
                            <field name="vaccination_status"/>
                            <field name="neutered_status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- vet.animal Window Action -->
        <record id="action_vet_animal" model="ir.actions.act_window">
            <field name="name">Animals</field>
            <field name="res_model">vet.animal</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new animal record.
                </p>
            </field>
        </record>
    </data>
</odoo>
