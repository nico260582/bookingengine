<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- vet.owner Tree View -->
        <record id="view_vet_owner_tree" model="ir.ui.view">
            <field name="name">vet.owner.tree</field>
            <field name="model">vet.owner</field>
            <field name="arch" type="xml">
                <tree string="Owners">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                </tree>
            </field>
        </record>

        <!-- vet.owner Form View -->
        <record id="view_vet_owner_form" model="ir.ui.view">
            <field name="name">vet.owner.form</field>
            <field name="model">vet.owner</field>
            <field name="arch" type="xml">
                <form string="Owner">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- vet.owner Window Action -->
        <record id="action_vet_owner" model="ir.actions.act_window">
            <field name="name">Owners</field>
            <field name="res_model">vet.owner</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new owner record.
                </p>
            </field>
        </record>
    </data>
</odoo>
