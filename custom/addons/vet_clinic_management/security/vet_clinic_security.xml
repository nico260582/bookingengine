<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_vet_clinic">
            <field name="name">Veterinary Clinic</field>
            <field name="description">User access levels for the Veterinary Clinic Management module</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_vet_clinic_user" model="res.groups">
            <field name="name">Veterinary User</field>
            <field name="category_id" ref="module_category_vet_clinic"/>
        </record>

        <record id="group_vet_clinic_manager" model="res.groups">
            <field name="name">Veterinary Manager</field>
            <field name="category_id" ref="module_category_vet_clinic"/>
            <field name="implied_ids" eval="[(4, ref('group_vet_clinic_user'))]"/>
        </record>
    </data>
</odoo>
