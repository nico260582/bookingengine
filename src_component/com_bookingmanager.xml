<?xml version="1.0" encoding="utf-8"?>

<extension type="component" version="3.1" method="upgrade">
    <name>com_bookingmanager</name>
    <author>RT-Holidays</author>
    <creationDate>August 2025</creationDate>
    <copyright>Copyright (C) 2025 RT-Holidays. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>contact@rt-holidays.com</authorEmail>
    <authorUrl>https://www.book-holidays-mauritius.com</authorUrl>
    <version>16.0.1</version>
    <description>A component to manage booking requests and suppliers.</description>
    <scriptfile>script.php</scriptfile>
    
    <files folder="site">
        <filename>bookingmanager.php</filename>
        <filename>controller.php</filename>
        <filename>index.html</filename>
        <folder>views</folder>
        <folder>models</folder>
        <folder>controllers</folder>
    </files>

    <languages folder="site/language">
        <language tag="en-GB">en-GB/en-GB.com_bookingmanager.ini</language>
    </languages>

    <administration>
        <menu link="option=com_bookingmanager">Booking Manager</menu>
        <submenu>
            <menu view="bookingrequests" link="option=com_bookingmanager&amp;view=bookingrequests">Booking Requests</menu>
            <menu view="suppliers" link="option=com_bookingmanager&amp;view=suppliers">Suppliers</menu>
            <menu view="propertyrates" link="option=com_bookingmanager&amp;view=propertyrates">Property Rates</menu>
            <menu view="templates" link="option=com_bookingmanager&amp;view=templates">Email Templates</menu>
            <menu view="diagnostic" link="option=com_bookingmanager&amp;view=diagnostic">Diagnostic</menu>
        </submenu>
        <files folder="administrator">
            <filename>bookingmanager.php</filename>
            <filename>controller.php</filename>
            <filename>config.xml</filename>
            <folder>controllers</folder>
            <folder>forms</folder>
            <folder>helpers</folder>
            <folder>models</folder>
            <folder>tables</folder>
            <folder>views</folder>
        </files>
        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/en-GB.com_bookingmanager.sys.ini</language>
        </languages>
    </administration>
</extension>
