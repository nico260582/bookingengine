<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="4.0" method="upgrade">
    <name>com_bookingmanager</name>
    <author>RT-Holidays</author>
    <creationDate>August 2025</creationDate>
    <copyright>Copyright (C) 2025 RT-Holidays. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>contact@rt-holidays.com</authorEmail>
    <authorUrl>https://www.book-holidays-mauritius.com</authorUrl>
    <version>5.0.0</version>
    <description>A component to manage booking requests and suppliers for Joomla 5.</description>
    <scriptfile>administrator/script.php</scriptfile>

    <namespace>RTHolidays\Component\BookingManager</namespace>

    <schemas>
        <schemapath type="mysql">administrator/sql/updates/mysql</schemapath>
    </schemas>

    <files folder="site">
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <administration>
        <menu link="option=com_bookingmanager">Booking Manager</menu>
        <submenu>
            <menu view="bookingrequests" link="option=com_bookingmanager&amp;view=bookingrequests" img="class:fa-calendar">Booking Requests</menu>
            <menu view="properties" link="option=com_bookingmanager&amp;view=properties" img="class:fa-home">Properties</menu>
            <menu view="complexes" link="option=com_bookingmanager&amp;view=complexes" img="class:fa-folder-open">Complexes</menu>
            <menu view="regions" link="option=com_bookingmanager&amp;view=regions" img="class:fa-map-marker">Regions</menu>
            <menu view="suppliers" link="option=com_bookingmanager&amp;view=suppliers" img="class:fa-user">Suppliers</menu>
            <menu view="propertyrates" link="option=com_bookingmanager&amp;view=propertyrates" img="class:fa-tags">Property Rates</menu>
            <menu view="templates" link="option=com_bookingmanager&amp;view=templates" img="class:fa-envelope">Email Templates</menu>
            <menu view="diagnostic" link="option=com_bookingmanager&amp;view=diagnostic" img="class:fa-cogs">Diagnostic</menu>
        </submenu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>src</folder>
            <folder>sql</folder>
            <folder>language</folder>
            <folder>layouts</folder>
        </files>
    </administration>
</extension>
