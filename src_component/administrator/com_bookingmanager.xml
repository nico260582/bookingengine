    <authorEmail>contact@rt-holidays.com</authorEmail>
    <authorUrl>https://www.book-holidays-mauritius.com</authorUrl>
    <version>1.4.0</version>
    <description>A component to manage booking requests and suppliers.</description>
    <scriptfile>script.php</scriptfile>
    
    <files folder="site">
        <filename>bookingmanager.php</filename>
        <filename>controller.php</filename>
        <filename>index.html</filename>
        <folder>views</folder>
        <folder>models</folder>
        <folder>controllers</folder>
        <folder>language</folder>
    </files>

    <administration>
        <menu link="option=com_bookingmanager">Booking Manager</menu>
        <submenu>
            <menu view="bookingrequests" link="option=com_bookingmanager&amp;view=bookingrequests" img="class:icon-calendar">Booking Requests</menu>
            <menu view="properties" link="option=com_bookingmanager&amp;view=properties" img="class:icon-home">Properties</menu>
            <menu view="complexes" link="option=com_bookingmanager&amp;view=complexes" img="class:icon-folder-open">Complexes</menu>
            <menu view="suppliers" link="option=com_bookingmanager&amp;view=suppliers" img="class:icon-user">Suppliers</menu>
            <menu view="propertyrates" link="option=com_bookingmanager&amp;view=propertyrates" img="class:icon-tags">Property Rates</menu>
            <menu view="templates" link="option=com_bookingmanager&amp;view=templates" img="class:icon-envelope">Email Templates</menu>
            <menu view="diagnostic" link="option=com_bookingmanager&amp;view=diagnostic" img="class:icon-cogs">Diagnostic</menu>
        </submenu>
        <access aclinfile="access.xml"/>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>bookingmanager.php</filename>
            <filename>controller.php</filename>
            <filename>config.xml</filename>
            <filename>controllers/bookingrequest.php</filename>
            <filename>controllers/bookingrequests.php</filename>
            <filename>controllers/complex.php</filename>
            <filename>controllers/complexes.php</filename>
            <filename>controllers/diagnostic.php</filename>
            <filename>controllers/index.html</filename>
            <filename>controllers/properties.php</filename>
            <filename>controllers/property.php</filename>
            <filename>controllers/propertyrates.php</filename>
            <filename>controllers/supplier.php</filename>
            <filename>controllers/suppliers.php</filename>
            <filename>controllers/template.php</filename>
            <filename>controllers/templates.php</filename>
            <folder>forms</folder>
            <folder>helpers</folder>
            <folder>models</folder>
            <folder>sql</folder>
            <folder>tables</folder>
            <folder>views</folder>
            <folder>assets</folder>
            <folder>layouts</folder>
            <folder>language</folder>
        </files>
    </administration>
</extension>
