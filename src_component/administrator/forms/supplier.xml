<?xml version="1.0" encoding="utf-8"?>
<form addfieldpath="/administrator/components/com_bookingmanager/models/fields">
    <fieldset name="details">
        <field name="id" type="hidden" />
        <field name="name" type="text" label="Supplier Name" required="true" />
        <field name="alias" type="text" label="Alias" />
        <field name="abbreviation" type="text" label="Abbreviation" required="true" size="10" />
        <field name="contact_email" type="email" label="Contact Email" />
        <field name="published" type="list" label="Status" default="1">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
    </fieldset>
    <fieldset name="pricing_model_rules" label="Pricing Model">
        <field name="pricing_model" type="list" label="Pricing Model" default="SupplementPerGuest">
            <option value="SupplementPerGuest">Supplement per Guest</option>
            <option value="FlatUnitRate">Flat Unit Rate</option>
            <option value="CapacityBased">Capacity Based (Mattress-for-One)</option>
            <option value="CustomCapacity">Custom Capacity Pricing</option>
        </field>
        <field name="adult_supplement" type="number" label="Default Adult Supplement" step="0.01" class="bm-showon-supplement" size="10"/>
        <field name="child_supplement" type="number" label="Default Child Supplement" step="0.01" class="bm-showon-supplement" size="10"/>
        <field name="extra_mattress_fee" type="number" label="Default Extra Mattress Fee" step="0.01" class="bm-showon-capacity"/>
    </fieldset>
    <fieldset name="guest_age_rules" label="Guest Age Rules">
        <field name="infant_max_age" type="number" label="Infant Max Age" description="Guests this age or younger are Infants for this supplier." default="5" filter="integer" size="5" />
        <field name="child_max_age" type="number" label="Child Max Age" description="Guests older than an infant and this age or younger are Children." default="12" filter="integer" size="5" />
        <field name="teen_max_age" type="number" label="Teen Max Age" description="Guests older than a child and this age or younger are Teens." default="17" filter="integer" size="5" />
        <field name="free_with_parents_age" type="number" label="Free with Parents Age Limit" description="For applicable models, children this age or younger can stay free, sharing existing beds." filter="integer" size="5" />
    </fieldset>
    <fieldset name="seasons_rules" label="Seasons">
        <field name="seasons" type="subform" label="Define Seasons" layout="joomla.form.field.subform.repeatable-table" multiple="true">
            <form>
                <field name="name" type="text" label="Season Name" size="15" required="true" />
                <field name="start_date" type="calendar" label="Start Date" format="%Y-%m-%d" required="true" />
                <field name="end_date" type="calendar" label="End Date" format="%Y-%m-%d" required="true" />
                <field name="min_stay" type="number" label="Min. Stay" default="1" size="4" />
                <field name="apply_child_supplement" type="list" label="Apply Child Supplement?" default="1" filter="integer">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="admin_commission" type="number" label="Admin Commission %" description="Commission by percentage for each season." step="0.01" size="4" />
            </form>
        </field>
    </fieldset>
    <fieldset name="discounts" label="Discount Rules">
        <field name="out_of_season_surcharge" type="number" label="Out-of-Season Surcharge %" description="Surcharge for bookings outside of defined seasons." default="10" step="0.01" />
        <field name="global_discount" type="number" label="Global Discount %" description="A global discount that applies if no country-specific discount is available." step="0.01" />
        <field name="show_global_discount_notification" type="radio" class="btn-group" default="1" label="Show Global Discount Notification to Client?">
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field
            name="country_discounts"
            type="subform"
            label="Country-Specific Discounts"
            description="Apply a discount for clients from a specific country. This is automatically applied on the front-end form."
            layout="joomla.form.field.subform.repeatable-table"
            multiple="true">
            <form>
                <field name="country" type="bookingmanagercountry" default="" label="Country" required="true" />
                <field name="discount_percent" type="number" label="Discount %" step="0.01" required="true" />
                <field name="note" type="text" label="Note for User &amp; Admin" description="e.g., You've received the 5% Mauritian Resident discount!" />
                <field name="start_date" type="calendar" label="Start Date" format="%Y-%m-%d" />
                <field name="end_date" type="calendar" label="End Date" format="%Y-%m-%d" />
                <field name="is_permanent" type="list" label="Permanent?" default="0">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </form>
        </field>
        <field
            name="coupon_codes"
            type="subform"
            label="Coupon Codes"
            description="Create custom coupon codes. If a start and end date are not set, the 'Permanent?' flag must be set to 'Yes' for the coupon to be active."
            layout="joomla.form.field.subform.repeatable-table"
            multiple="true">
            <form>
                <field name="code" type="text" label="Coupon Code" required="true" />
                <field name="discount_percent" type="number" label="Discount %" step="0.01" required="true" />
                <field name="start_date" type="calendar" label="Start Date" format="%Y-%m-%d" />
                <field name="end_date" type="calendar" label="End Date" format="%Y-%m-%d" />
                <field name="is_permanent" type="list" label="Permanent?" default="0">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </form>
        </field>
    </fieldset>
        <fieldset name="markets_rules" label="Market Pricing" addfieldpath="/administrator/components/com_bookingmanager/models/fields">
            <field
                name="markets"
                type="marketassignment"
                label="Define Price Markets"
                description="Select countries to define them as special price markets. For each market, you must specify a currency. The first market in the list will be considered the default."
            />
        </fieldset>
    <fieldset name="assignments" label="Property Assignments">
        <field name="properties" type="hidden" />
    </fieldset>
    <fieldset name="terms_and_conditions" label="Terms and Conditions">
        <field
            name="terms_and_conditions"
            type="editor"
            label="Terms and Conditions"
            description="The terms and conditions for this supplier."
            filter="safehtml"
        />
    </fieldset>
</form>