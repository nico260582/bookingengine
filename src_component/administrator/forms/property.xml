<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details" addfieldpath="/administrator/components/com_bookingmanager/models/fields">
        <field
            name="id"
            type="hidden"
        />
        <field
            name="article_id"
            type="sql"
            query="SELECT id AS value, title AS title FROM #__content WHERE id NOT IN (SELECT article_id FROM #__bookingmanager_properties) ORDER BY title"
            key_field="value"
            value_field="title"
            label="COM_BOOKINGMANAGER_PROPERTY_ARTICLE_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_ARTICLE_DESC"
            required="true"
            header="Select an Article"
        />
        <field
            name="max_guests"
            type="number"
            label="COM_BOOKINGMANAGER_PROPERTY_MAX_GUESTS_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_MAX_GUESTS_DESC"
            required="true"
            min="1"
            step="1"
        />
        <field
            name="base_guest_number"
            type="list"
            label="Base Guest Number"
            description="The number of guests included in the base rate for the 'Custom Capacity' pricing model. Leave blank if not applicable."
            default=""
        >
            <option value="">Select...</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
            <option value="13">13</option>
            <option value="14">14</option>
            <option value="15">15</option>
            <option value="16">16</option>
            <option value="17">17</option>
            <option value="18">18</option>
            <option value="19">19</option>
            <option value="20">20</option>
        </field>
        <field
            name="main_region_id"
            type="sql"
            query="SELECT id AS value, name FROM #__bookingmanager_main_regions WHERE published = 1 ORDER BY name"
            key_field="value"
            value_field="name"
            label="COM_BOOKINGMANAGER_PROPERTY_MAIN_REGION_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_MAIN_REGION_DESC"
            required="true"
        >
            <option value="">COM_BOOKINGMANAGER_SELECT_MAIN_REGION</option>
        </field>
        <field
            name="sub_region_id"
            type="list"
            label="COM_BOOKINGMANAGER_PROPERTY_SUB_REGION_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_SUB_REGION_DESC"
            required="true"
        >
            <option value="">COM_BOOKINGMANAGER_SELECT_SUB_REGION</option>
        </field>
        <field
            name="allow_extra_mattress"
            type="radio"
            label="COM_BOOKINGMANAGER_PROPERTY_ALLOW_EXTRA_MATTRESS_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_ALLOW_EXTRA_MATTRESS_DESC"
            class="btn-group btn-group-yesno"
            default="0"
        >
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field
            name="number_of_units"
            type="number"
            label="Number of Available Units"
            description="Enter the total number of units available for this property (e.g., if it's a block of 4 identical apartments, enter 4). Defaults to 1."
            required="true"
            min="1"
            step="1"
        />
        <field
            name="complexes"
            type="complexassignment"
            label="COM_BOOKINGMANAGER_PROPERTY_COMPLEX_ASSIGNMENT_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_COMPLEX_ASSIGNMENT_DESC"
        />
        <!-- This field tells Joomla to allow the 'rates' data to pass validation -->
        <field
            name="rates"
            type="hidden"
        />
        <field
            name="active_markets"
            type="hidden"
        />
    </fieldset>
</form>
