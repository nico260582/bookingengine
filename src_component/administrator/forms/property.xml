<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details" addfieldpath="/administrator/components/com_bookingmanager/models/fields">
        <field
            name="id"
            type="hidden"
        />
        <field
            name="article_id"
            type="sql"
            query="SELECT id AS value, title AS title FROM #__content WHERE id NOT IN (SELECT article_id FROM #__bookingmanager_properties) ORDER BY title"
            key_field="value"
            value_field="title"
            label="COM_BOOKINGMANAGER_PROPERTY_ARTICLE_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_ARTICLE_DESC"
            required="true"
            header="Select an Article"
        />
        <field
            name="max_guests"
            type="number"
            label="COM_BOOKINGMANAGER_PROPERTY_MAX_GUESTS_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_MAX_GUESTS_DESC"
            required="true"
            min="1"
            step="1"
        />
        <field
            name="pricing_model"
            type="hidden"
        />
        <field
            name="allow_extra_mattress"
            type="radio"
            label="COM_BOOKINGMANAGER_PROPERTY_ALLOW_EXTRA_MATTRESS_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_ALLOW_EXTRA_MATTRESS_DESC"
            class="btn-group btn-group-yesno"
            default="0"
            showon="pricing_model:CapacityBased"
        >
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field
            name="number_of_units"
            type="number"
            label="Number of Available Units"
            description="Enter the total number of units available for this property (e.g., if it's a block of 4 identical apartments, enter 4). Defaults to 1."
            required="true"
            min="1"
            step="1"
        />
        <field
            name="complexes"
            type="complexassignment"
            label="COM_BOOKINGMANAGER_PROPERTY_COMPLEX_ASSIGNMENT_LABEL"
            description="COM_BOOKINGMANAGER_PROPERTY_COMPLEX_ASSIGNMENT_DESC"
        />
        <!-- This field tells Joomla to allow the 'rates' data to pass validation -->
        <field
            name="rates"
            type="hidden"
        />
        <field
            name="active_markets"
            type="hidden"
        />
    </fieldset>
</form>
